# Copy this file to .env.local and fill in your own values.
#
# Leaving everything unset is fine — Supabase-dependent features (sign-in,
# cross-device sync, the leaderboard) are simply off, and the Groq Prompt
# Playground shows a "not set up yet" message instead of erroring out.

# --- Supabase (optional) ---
# Find both in your Supabase project: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Groq (needed for the Live Prompt Playground) ---
# One shared key for the whole class/site. Get a free one (no credit card)
# at https://console.groq.com/keys. This is a SERVER-ONLY secret — it has no
# NEXT_PUBLIC_ prefix, so it's never sent to the browser. Do not commit it.
GROQ_API_KEY=
